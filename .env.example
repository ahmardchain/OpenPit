# --- server (never commit real values) ---
# Private keys used ONLY by scripts/smoke.ts and scripts/e2e.ts. The web app never sees keys.
SMOKE_PRIVATE_KEY=0x...
SMOKE_PRIVATE_KEY_2=0x...

# Pit metadata lives in Cloudflare D1 (binding DB in wrangler.jsonc); no env var needed.

# Public URL for share links and OG images. Leave empty to use the request host.
NEXT_PUBLIC_APP_URL=

# Somnia Hideki testnet (chain 50383) — defaults match the dreamDEX dev docs
NEXT_PUBLIC_RPC_HTTP=https://api.hideki2.infra.testnet.somnia.network
NEXT_PUBLIC_RPC_WS=wss://api.hideki2.infra.testnet.somnia.network/ws
NEXT_PUBLIC_INDEXER=https://hideki-dev.smk.somnia.host/v1/graphql

# WalletConnect Cloud project id (RainbowKit). Optional for injected wallets.
NEXT_PUBLIC_WC_PROJECT_ID=
